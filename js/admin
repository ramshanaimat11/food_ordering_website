// js/admin.js
document.addEventListener("DOMContentLoaded", () => {
    const orders = StorageManager.getOrders();
    const users = StorageManager.getUsers();

    const revenue = orders.reduce((sum, o) => sum + Number(o.total || 0), 0);
    document.getElementById("statOrders").textContent = orders.length;
    document.getElementById("statRevenue").textContent = `Rs. ${Math.round(revenue).toLocaleString()}`;
    document.getElementById("statUsers").textContent = users.length;

    const tbody = document.getElementById("adminOrdersBody");

    function renderAdminOrders() {
        const latestOrders = StorageManager.getOrders();
        if (latestOrders.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No orders placed yet.</td></tr>`;
            return;
        }

        tbody.innerHTML = latestOrders.map((o, idx) => `
            <tr>
                <td><strong>${o.orderId}</strong></td>
                <td>${o.customerName}<br><small style="color:var(--text-muted);">${o.customerPhone}</small></td>
                <td>${o.items.map(i => `${i.quantity}x ${i.name}`).join(", ")}</td>
                <td style="color:var(--primary); font-weight:700;">Rs. ${Math.round(o.total).toLocaleString()}</td>
                <td>
                    <select onchange="updateOrderStatus(${idx}, this.value)">
                        <option ${o.status === "Order Placed" ? "selected" : ""}>Order Placed</option>
                        <option ${o.status === "Preparing" ? "selected" : ""}>Preparing</option>
                        <option ${o.status === "Out for Delivery" ? "selected" : ""}>Out for Delivery</option>
                        <option ${o.status === "Delivered" ? "selected" : ""}>Delivered</option>
                    </select>
                </td>
                <td><a href="track-order.html?id=${o.orderId}" class="customize-btn">View</a></td>
            </tr>
        `).join("");
    }

    window.updateOrderStatus = function (index, newStatus) {
        const latestOrders = StorageManager.getOrders();
        latestOrders[index].status = newStatus;
        StorageManager.saveOrders(latestOrders);
        showGlobalToast(`Order ${latestOrders[index].orderId} updated to ${newStatus}`);
    };

    renderAdminOrders();
});