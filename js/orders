// js/orders.js
document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("ordersListContainer");
    const orders = StorageManager.getOrders();

    function formatPrice(amount) {
        return `Rs. ${Math.round(amount).toLocaleString()}`;
    }

    if (orders.length === 0) {
        container.innerHTML = `
            <div style="text-align:center; padding:40px 0;">
                <p style="color:var(--text-muted); margin-bottom:16px;">You haven't placed any orders yet.</p>
                <a href="menu.html" class="primary-btn">Explore Menu</a>
            </div>
        `;
        return;
    }

    container.innerHTML = orders.map(order => `
        <div class="order-card">
            <div class="order-card-top">
                <div>
                    <strong style="color:var(--primary); font-size:16px;">${order.orderId}</strong>
                    <div style="font-size:12px; color:var(--text-muted);">${order.date}</div>
                </div>
                <span class="status-pill ${order.status === "Delivered" ? "delivered" : ""}">${order.status}</span>
            </div>
            <div style="font-size:14px; color:#d1d5db; margin-bottom:12px;">
                ${order.items.map(i => `${i.quantity}x ${i.name}`).join(", ")}
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <strong>Total: <span style="color:var(--primary);">${formatPrice(order.total)}</span></strong>
                <a href="track-order.html?id=${order.orderId}" class="customize-btn">Track Order</a>
            </div>
        </div>
    `).join("");
});